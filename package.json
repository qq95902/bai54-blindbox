{
  "name": "bai-blind-box-dapp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <24"
  },
  "scripts": {
    "compile": "node scripts/compile.mjs",
    "build:wallet": "node scripts/build-wallet-connect.mjs",
    "deploy:testnet:check": "node scripts/deploy-testnet.mjs",
    "deploy:testnet": "node scripts/deploy-testnet.mjs --execute",
    "audit:testnet": "node scripts/audit-testnet.mjs",
    "verify:testnet": "node scripts/verify-testnet.mjs",
    "deploy:mainnet:check": "node scripts/deploy-mainnet.mjs",
    "deploy:mainnet": "node scripts/deploy-mainnet.mjs --execute",
    "backend:sandbox:simulate": "npm --prefix backend run sandbox:simulate",
    "backend:sandbox:load-3000": "npm --prefix backend run sandbox:load-3000",
    "sandbox:simulate": "node sandbox/ensure-deps.mjs && node sandbox/purchase-vault-client.mjs && node sandbox/oracle.mjs && node sandbox/run.mjs",
    "sandbox:load-3000": "node sandbox/ensure-deps.mjs && node sandbox/load-3000.mjs"
  },
  "dependencies": {
    "@walletconnect/universal-provider": "2.26.0",
    "ethers": "6.17.0",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@openzeppelin/contracts": "5.4.0",
    "esbuild": "0.25.12",
    "solc": "0.8.26"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
