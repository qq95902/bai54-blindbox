# Copy to .env.testnet, fill the placeholders, and keep the copy out of Git.
# The v12 deployment is irreversible on testnet and submits real transactions.
BSC_TESTNET_RPC_URL=https://bsc-testnet-dataseed.bnbchain.org
# Prefer a key file outside the repository; use a dedicated testnet deployer.
# DEPLOYER_PRIVATE_KEY_FILE=/absolute/path/to/testnet-deployer.key
BSC_TESTNET_PURCHASE_KEEPER_ADDRESS=
BSC_TESTNET_OPERATIONS_TREASURY=
# Optional; defaults to the deployer address.
# BSC_TESTNET_LP_BENEFICIARY=

# Must be a non-zero Chainlink VRF v2.5 gas lane key hash and a subscription
# owned by the configured deployer, with enough tBNB and consumer capacity.
BSC_TESTNET_VRF_KEY_HASH=
BSC_TESTNET_VRF_SUBSCRIPTION_ID=
# Must match backend/.env.testnet's VRF_MIN_NATIVE_BALANCE_BNB operating floor.
VRF_MIN_NATIVE_BALANCE_BNB=0.1

# Public HTTPS origin of the API deployed from backend/. The generated dApp
# config uses this for purchase status and backend-backed reads.
PUBLIC_API_BASE_URL=https://api.example.com
# Public WalletConnect Cloud project ID used for desktop QR pairing; not a private key.
WALLETCONNECT_PROJECT_ID=

# Optional test liquidity. The deploy script defaults to 2 test USDT and 80,000 BAI.
# BSC_TESTNET_INITIAL_SEED_USDT=2
# BSC_TESTNET_INITIAL_SEED_BAI=80000
