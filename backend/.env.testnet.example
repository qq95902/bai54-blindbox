# BAI v12 backend settings for BNB Smart Chain Testnet (chain ID 97).
# Testnet-only: do not use this file for mainnet or treat public RPCs as production-grade.
NODE_ENV=production
PORT=8080
PUBLIC_SITE_ORIGINS=https://qq95902.github.io
TRUSTED_PROXY_IPS=

# Replace with a private PostgreSQL database. Keep it off the public internet.
DATABASE_URL=postgres://bai_app:CHANGE_ME@postgres.internal:5432/bai_testnet

# Use two distinct RPC operators; these public endpoints are suitable for testnet only.
BSC_CHAIN_ID=97
BSC_RPC_URLS=https://bsc-testnet-dataseed.bnbchain.org,https://bsc-testnet-rpc.publicnode.com

GAME_ADDRESS=REPLACE_WITH_V12_GAME_ADDRESS
FREE_DROP_ADDRESS=REPLACE_WITH_V12_FREE_DROP_ADDRESS
LIQUIDITY_MANAGER_ADDRESS=REPLACE_WITH_V12_LIQUIDITY_MANAGER_ADDRESS
USDT_ADDRESS=REPLACE_WITH_V12_TEST_USDT_ADDRESS
PURCHASE_PROCESSOR_ADDRESS=REPLACE_WITH_V12_PURCHASE_PROCESSOR_ADDRESS

# Replace with v12 deployment block numbers from deployments/bsc-testnet-v12.json.
DEPLOYMENT_BLOCK=REPLACE_WITH_V12_DEPLOYMENT_BLOCK
GAME_DEPLOYMENT_BLOCK=REPLACE_WITH_V12_GAME_DEPLOYMENT_BLOCK
FREE_DROP_DEPLOYMENT_BLOCK=REPLACE_WITH_V12_FREE_DROP_DEPLOYMENT_BLOCK
LIQUIDITY_MANAGER_DEPLOYMENT_BLOCK=REPLACE_WITH_V12_LIQUIDITY_MANAGER_DEPLOYMENT_BLOCK
PURCHASE_PROCESSOR_DEPLOYMENT_BLOCK=REPLACE_WITH_V12_PROCESSOR_DEPLOYMENT_BLOCK

INDEXER_CONFIRMATIONS=3
INDEXER_BLOCK_RANGE=100
DEPOSIT_LOG_RECIPIENT_BATCH_SIZE=500
KEEPER_INTERVAL_MS=15000
KEEPER_CONFIRMATIONS=3
KEEPER_PRIVATE_KEY_FILE=/run/secrets/keeper_private_key
KEEPER_MIN_BNB_BALANCE=0.05
VRF_SUBSCRIPTION_ID=62224439238952900277820817768287453736344994384904839943325233531854589005264
# Top up the testnet VRF subscription before this operating threshold is crossed.
VRF_MIN_NATIVE_BALANCE_BNB=0.1

METRICS_BEARER_TOKEN=REPLACE_WITH_A_LONG_RANDOM_VALUE

# The Keeper key above must derive to purchaseKeeper in the v12 manifest.
