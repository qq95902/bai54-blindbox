NODE_ENV=production
PORT=8080
PUBLIC_SITE_ORIGINS=https://qq95902.github.io
# Set the exact private IP addresses of the reverse proxies/load balancers that connect to the API.
# Leave empty when clients connect directly; forwarded headers from untrusted peers are ignored.
TRUSTED_PROXY_IPS=
DATABASE_URL=postgres://bai_app:CHANGE_ME@postgres.internal:5432/bai
BSC_CHAIN_ID=56
BSC_RPC_URLS=https://rpc-provider-a.example,https://rpc-provider-b.example
GAME_ADDRESS=
FREE_DROP_ADDRESS=
LIQUIDITY_MANAGER_ADDRESS=
DEPLOYMENT_BLOCK=0
GAME_DEPLOYMENT_BLOCK=0
FREE_DROP_DEPLOYMENT_BLOCK=0
LIQUIDITY_MANAGER_DEPLOYMENT_BLOCK=0
INDEXER_CONFIRMATIONS=12
INDEXER_BLOCK_RANGE=1000
DEPOSIT_LOG_RECIPIENT_BATCH_SIZE=500
KEEPER_INTERVAL_MS=15000
KEEPER_CONFIRMATIONS=3
PURCHASE_DEPOSIT_CONCURRENCY=25
KEEPER_PRIVATE_KEY_FILE=/run/secrets/keeper_private_key
KEEPER_MIN_BNB_BALANCE=0.05
VRF_SUBSCRIPTION_ID=
VRF_MIN_NATIVE_BALANCE_BNB=0.5
METRICS_BEARER_TOKEN=CHANGE_ME
