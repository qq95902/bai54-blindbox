# Copy to .env.mainnet. Keep .env.mainnet and all key files out of Git.
BSC_MAINNET_RPC_URL=
DEPLOYER_PRIVATE_KEY_FILE=/absolute/path/to/private/deployer-key.txt
# Alternative: DEPLOYER_PRIVATE_KEY=0x... (keep this file private)
OPERATIONS_TREASURY=
# Public address controlled by the dedicated backend Keeper key; must match the Keeper service identity.
# Dedicated EOA whose key is mounted only into the backend Keeper service.
# Keep it separate from the deployer and operations treasury.
PURCHASE_KEEPER_ADDRESS=
VRF_SUBSCRIPTION_ID=
# Keeper warning floor and deploy preflight minimum; set this from the expected VRF request volume and top-up policy.
VRF_MIN_NATIVE_BALANCE_BNB=0.5
VRF_CALLBACK_GAS_LIMIT=500000
VRF_REQUEST_CONFIRMATIONS=3
INITIAL_LIQUIDITY_BSC_USD=
ORACLE_MIN_POOL_VALUE_USD=
PUBLIC_API_BASE_URL=https://api.example.com
# Public WalletConnect Cloud project ID used for desktop QR pairing; not a private key.
WALLETCONNECT_PROJECT_ID=
# Optional overrides; defaults are BSC-USD, PancakeSwap V2, and Chainlink VRF BNB mainnet.
# QUOTE_TOKEN_ADDRESS=
# PANCAKE_V2_ROUTER=
# VRF_COORDINATOR=
# VRF_KEY_HASH=
# LP_BENEFICIARY=
